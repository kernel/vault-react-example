# The exact origin serving this app. PATCH requests from any other origin are rejected.
APP_ORIGIN=http://localhost:3000

# Run against an in-process fake vault. Never enter real credentials in mock mode.
MOCK_VAULT=true

# Required when MOCK_VAULT=false. This key stays on the server.
KERNEL_API_KEY=
# KERNEL_API_BASE_URL=https://api.onkernel.com

# Local links are written to .data/credential-requests.json.
# Replace FileCollectionRequestStore with your database in production.
COLLECTION_REQUEST_TTL_MINUTES=15
